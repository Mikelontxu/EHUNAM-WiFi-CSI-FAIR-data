  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "en",
    "@value" : "This ontology provides a structured representation of WiFi Channel State Information (CSI) measurements, including details about the measurement environment, involved persons, activities performed, and technical parameters."
  } ],
