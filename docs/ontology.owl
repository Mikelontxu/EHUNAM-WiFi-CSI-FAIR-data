    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/ns/sosa/hasResult -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasResult"/>
    


    <!-- https://w3id.org/WiFi-CSIactivity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/WiFi-CSIactivity">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="https://w3id.org/WiFi-CSIActivity"/>
        <rdfs:comment xml:lang="es">Relaciona una medición WiFi con el tipo de actividad realizada por una persona durante la medición</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a WiFi measurement to the type of activity performed by a person during the measurement</rdfs:comment>
        <rdfs:label xml:lang="es">Actividad</rdfs:label>
        <rdfs:label xml:lang="en">Activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/WiFi-CSIapplication -->


    <owl:ObjectProperty rdf:about="https://w3id.org/WiFi-CSIapplication">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="https://w3id.org/WiFi-CSIApplication"/>
        <rdfs:comment xml:lang="es">Relaciona una medición WiFi con la aplicación o caso de uso con el que está asociada</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a WiFi measurement to the application or use case it is associated with</rdfs:comment>
        <rdfs:label xml:lang="es">Aplicación</rdfs:label>
        <rdfs:label xml:lang="en">Application</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/WiFi-CSIbandwidth -->


    <owl:ObjectProperty rdf:about="https://w3id.org/WiFi-CSIbandwidth">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="https://w3id.org/WiFi-CSIBandwidth"/>
        <rdfs:comment xml:lang="es">Relaciona una medición WiFi con el ancho de banda de la señal WiFi utilizada para la medición</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a WiFi measurement to the bandwidth of the WiFi signal used for the measurement</rdfs:comment>
        <rdfs:label xml:lang="es">Ancho de banda</rdfs:label>
        <rdfs:label xml:lang="en">Bandwidth</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/WiFi-CSIcsiExtractor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/WiFi-CSIcsiExtractor">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="https://w3id.org/WiFi-CSICSIExtractor"/>
        <rdfs:comment xml:lang="es">Relaciona una medición WiFi con la herramienta o método extractor de CSI utilizado para obtener los datos CSI</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a WiFi measurement to the CSI extractor tool or method used to obtain the CSI data</rdfs:comment>
        <rdfs:label xml:lang="en">CSI extractor</rdfs:label>
        <rdfs:label xml:lang="es">Extractor de CSI</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/WiFi-CSIenvironment -->


    <owl:ObjectProperty rdf:about="https://w3id.org/WiFi-CSIenvironment">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="https://w3id.org/WiFi-CSIEnvironment"/>
        <rdfs:comment xml:lang="es">Relaciona una medición WiFi con el entorno físico donde se tomó</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a WiFi measurement to the physical environment where it was taken</rdfs:comment>
        <rdfs:label xml:lang="es">Entorno</rdfs:label>
        <rdfs:label xml:lang="en">Environment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/WiFi-CSIfrequencyBand -->


    <owl:ObjectProperty rdf:about="https://w3id.org/WiFi-CSIfrequencyBand">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="https://w3id.org/WiFi-CSIFrequencyBand"/>
        <rdfs:comment xml:lang="es">Relaciona una medición WiFi con la banda de frecuencia de la señal WiFi utilizada para la medición</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a WiFi measurement to the frequency band of the WiFi signal used for the measurement</rdfs:comment>
        <rdfs:label xml:lang="es">Banda de frecuencia</rdfs:label>
        <rdfs:label xml:lang="en">Frequency band</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/WiFi-CSIhasResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/WiFi-CSIhasResult">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/hasResult"/>
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="https://w3id.org/WiFi-CSICSIResult"/>
        <rdfs:comment xml:lang="es">Relaciona una medición WiFi con su resultado que contiene los datos CSI y timestamps</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a WiFi measurement to its result containing the CSI data and timestamps</rdfs:comment>
        <rdfs:label xml:lang="en">has result</rdfs:label>
        <rdfs:label xml:lang="es">tiene resultado</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/WiFi-CSIinvolvesPerson -->


    <owl:ObjectProperty rdf:about="https://w3id.org/WiFi-CSIinvolvesPerson">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="https://w3id.org/WiFi-CSIPerson"/>
        <rdfs:comment xml:lang="es">Relaciona una medición WiFi con la persona (la letra) involucrada en la medición</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a WiFi measurement to the person (the letter) involved in the measurement</rdfs:comment>
        <rdfs:label xml:lang="es">involucra persona</rdfs:label>
        <rdfs:label xml:lang="en">involves person</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/WiFi-CSImachineStatus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/WiFi-CSImachineStatus">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="https://w3id.org/WiFi-CSIMachineStatus"/>
        <rdfs:comment xml:lang="es">Relaciona una medición WiFi con el estado operativo de una máquina durante la medición</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a WiFi measurement to the operational status of a machine during the measurement</rdfs:comment>
        <rdfs:label xml:lang="es">Estado de la máquina</rdfs:label>
        <rdfs:label xml:lang="en">Machine status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/WiFi-CSImeasurementDuration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/WiFi-CSImeasurementDuration">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="https://w3id.org/WiFi-CSIDuration"/>
        <rdfs:comment xml:lang="es">Relaciona una medición WiFi con su duración en segundos</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a WiFi measurement to its duration in seconds</rdfs:comment>
        <rdfs:label xml:lang="es">Duración de la medición</rdfs:label>
        <rdfs:label xml:lang="en">Measurement duration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/WiFi-CSIwifiStandard -->


    <owl:ObjectProperty rdf:about="https://w3id.org/WiFi-CSIwifiStandard">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="https://w3id.org/WiFi-CSIWifiStandard"/>
        <rdfs:comment xml:lang="es">Relaciona una medición WiFi con el estándar WiFi utilizado para la medición</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a WiFi measurement to the WiFi standard used for the measurement</rdfs:comment>
        <rdfs:label xml:lang="es">Estándar WiFi</rdfs:label>
        <rdfs:label xml:lang="en">WiFi standard</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/WiFi-CSIcampaign -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/WiFi-CSIcampaign">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Identificador de la campaña de medición (e.g. MC1).</rdfs:comment>
        <rdfs:comment xml:lang="en">Measurement campaign identifier (e.g. MC1).</rdfs:comment>
        <rdfs:label xml:lang="en">campaign</rdfs:label>
        <rdfs:label xml:lang="es">campaña</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/WiFi-CSIchannel -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/WiFi-CSIchannel">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Canal WiFi utilizado durante la medición (11, 13 or 40).</rdfs:comment>
        <rdfs:comment xml:lang="en">WiFi channel used during the measurement (11, 13 or 40).</rdfs:comment>
        <rdfs:label xml:lang="es">canal</rdfs:label>
        <rdfs:label xml:lang="en">channel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/WiFi-CSImachine -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/WiFi-CSImachine">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Identificador de la máquina presente durante la medición (1–9).</rdfs:comment>
        <rdfs:comment xml:lang="en">Identifier of the machine present during the measurement (1–9).</rdfs:comment>
        <rdfs:label xml:lang="en">machine</rdfs:label>
        <rdfs:label xml:lang="es">máquina</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/WiFi-CSInFiles -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/WiFi-CSInFiles">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número total de archivos .mat en el conjunto al que pertenece esta medición.</rdfs:comment>
        <rdfs:comment xml:lang="en">Total number of .mat files in the set this measurement belongs to.</rdfs:comment>
        <rdfs:label xml:lang="en">number of files</rdfs:label>
        <rdfs:label xml:lang="es">número de archivos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/WiFi-CSInMachine -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/WiFi-CSInMachine">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número total de máquinas involucradas en la medición.</rdfs:comment>
        <rdfs:comment xml:lang="en">Total number of machines involved in the measurement.</rdfs:comment>
        <rdfs:label xml:lang="en">number of machines</rdfs:label>
        <rdfs:label xml:lang="es">número de máquinas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/WiFi-CSInPeople -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/WiFi-CSInPeople">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número total de personas presentes durante la medición.</rdfs:comment>
        <rdfs:comment xml:lang="en">Total number of people present during the measurement.</rdfs:comment>
        <rdfs:label xml:lang="en">number of people</rdfs:label>
        <rdfs:label xml:lang="es">número de personas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/WiFi-CSInReceivers -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/WiFi-CSInReceivers">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of receiver devices used in the measurement (1–4).</rdfs:comment>
        <rdfs:comment xml:lang="es">Número de dispositivos receptores utilizados en la medición (1–4).</rdfs:comment>
        <rdfs:label xml:lang="en">number of receivers</rdfs:label>
        <rdfs:label xml:lang="es">número de receptores</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/WiFi-CSInic -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/WiFi-CSInic">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Model of the network interface card of the CSI receiver.</rdfs:comment>
        <rdfs:comment xml:lang="es">Modelo de la tarjeta de interfaz de red del receptor de CSI.</rdfs:comment>
        <rdfs:label xml:lang="en">NIC</rdfs:label>
        <rdfs:label xml:lang="es">NIC</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/WiFi-CSIoccupiedSubcarriers -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/WiFi-CSIoccupiedSubcarriers">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of useful subcarriers (data + pilots) after excluding null subcarriers per IEEE 802.11n/ac.</rdfs:comment>
        <rdfs:comment xml:lang="es">Número de subportadoras útiles (datos + pilotos) después de excluir las subportadoras nulas según IEEE 802.11n/ac.</rdfs:comment>
        <rdfs:label xml:lang="en">occupied subcarriers</rdfs:label>
        <rdfs:label xml:lang="es">subportadoras ocupadas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/WiFi-CSIreceiver -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/WiFi-CSIreceiver">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Identificador del dispositivo receptor que capturó la medición (1–4).</rdfs:comment>
        <rdfs:comment xml:lang="en">Identifier of the receiver device that captured the measurement (1–4).</rdfs:comment>
        <rdfs:label xml:lang="en">receiver</rdfs:label>
        <rdfs:label xml:lang="es">receptor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/WiFi-CSIsequentialNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/WiFi-CSIsequentialNumber">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número secuencial para distinguir mediciones con metadatos idénticos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sequential number to distinguish measurements with otherwise identical metadata.</rdfs:comment>
        <rdfs:label xml:lang="es">número secuencial</rdfs:label>
        <rdfs:label xml:lang="en">sequential number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/WiFi-CSIset -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/WiFi-CSIset">
        <rdfs:domain rdf:resource="https://w3id.org/WiFi-CSIWifiMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Identificador del conjunto dentro de la campaña (e.g. MC1_01A). Cada conjunto corresponde a una ubicación específica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Set identifier within the campaign (e.g. MC1_01A). Each set corresponds to a specific location.</rdfs:comment>
        <rdfs:label xml:lang="es">conjunto</rdfs:label>
        <rdfs:label xml:lang="en">set</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/WiFi-CSIsubcarriers -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/WiFi-CSIsubcarriers">
