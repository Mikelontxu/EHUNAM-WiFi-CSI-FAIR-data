        <rdfs:comment xml:lang="en">Total number of OFDM subcarriers captured (64 for 20 MHz, 256 for 80 MHz in MC1).</rdfs:comment>
        <rdfs:label xml:lang="en">subcarriers</rdfs:label>
        <rdfs:label xml:lang="es">subportadoras</rdfs:label>
    </owl:DatatypeProperty>
    


