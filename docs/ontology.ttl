#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/ns/sosa/hasResult
<http://www.w3.org/ns/sosa/hasResult> rdf:type owl:ObjectProperty .


###  https://w3id.org/WiFi-CSI#activity
:activity rdf:type owl:ObjectProperty ;
          rdfs:domain :WifiMeasurement ;
          rdfs:range :Activity ;
          rdfs:comment "Relaciona una medición WiFi con el tipo de actividad realizada por una persona durante la medición"@es ,
                       "Relates a WiFi measurement to the type of activity performed by a person during the measurement"@en ;
          rdfs:label "Actividad"@es ,
                     "Activity"@en .


###  https://w3id.org/WiFi-CSI#application
:application rdf:type owl:ObjectProperty ;
             rdfs:domain :WifiMeasurement ;
             rdfs:range :Application ;
             rdfs:comment "Relaciona una medición WiFi con la aplicación o caso de uso con el que está asociada"@es ,
                          "Relates a WiFi measurement to the application or use case it is associated with"@en ;
             rdfs:label "Aplicación"@es ,
                        "Application"@en .


###  https://w3id.org/WiFi-CSI#bandwidth
:bandwidth rdf:type owl:ObjectProperty ;
           rdfs:domain :WifiMeasurement ;
           rdfs:range :Bandwidth ;
           rdfs:comment "Relaciona una medición WiFi con el ancho de banda de la señal WiFi utilizada para la medición"@es ,
                        "Relates a WiFi measurement to the bandwidth of the WiFi signal used for the measurement"@en ;
           rdfs:label "Ancho de banda"@es ,
                      "Bandwidth"@en .


###  https://w3id.org/WiFi-CSI#csiExtractor
:csiExtractor rdf:type owl:ObjectProperty ;
              rdfs:domain :WifiMeasurement ;
              rdfs:range :CSIExtractor ;
              rdfs:comment "Relaciona una medición WiFi con la herramienta o método extractor de CSI utilizado para obtener los datos CSI"@es ,
                           "Relates a WiFi measurement to the CSI extractor tool or method used to obtain the CSI data"@en ;
              rdfs:label "CSI extractor"@en ,
                         "Extractor de CSI"@es .


###  https://w3id.org/WiFi-CSI#environment
:environment rdf:type owl:ObjectProperty ;
             rdfs:domain :WifiMeasurement ;
             rdfs:range :Environment ;
             rdfs:comment "Relaciona una medición WiFi con el entorno físico donde se tomó"@es ,
                          "Relates a WiFi measurement to the physical environment where it was taken"@en ;
             rdfs:label "Entorno"@es ,
                        "Environment"@en .


###  https://w3id.org/WiFi-CSI#frequencyBand
:frequencyBand rdf:type owl:ObjectProperty ;
               rdfs:domain :WifiMeasurement ;
               rdfs:range :FrequencyBand ;
               rdfs:comment "Relaciona una medición WiFi con la banda de frecuencia de la señal WiFi utilizada para la medición"@es ,
                            "Relates a WiFi measurement to the frequency band of the WiFi signal used for the measurement"@en ;
               rdfs:label "Banda de frecuencia"@es ,
                          "Frequency band"@en .


###  https://w3id.org/WiFi-CSI#hasResult
:hasResult rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf <http://www.w3.org/ns/sosa/hasResult> ;
           rdfs:domain :WifiMeasurement ;
           rdfs:range :CSIResult ;
           rdfs:comment "Relaciona una medición WiFi con su resultado que contiene los datos CSI y timestamps"@es ,
                        "Relates a WiFi measurement to its result containing the CSI data and timestamps"@en ;
           rdfs:label "has result"@en ,
                      "tiene resultado"@es .


###  https://w3id.org/WiFi-CSI#involvesPerson
:involvesPerson rdf:type owl:ObjectProperty ;
                rdfs:domain :WifiMeasurement ;
                rdfs:range :Person ;
                rdfs:comment "Relaciona una medición WiFi con la persona (la letra) involucrada en la medición"@es ,
                             "Relates a WiFi measurement to the person (the letter) involved in the measurement"@en ;
                rdfs:label "involucra persona"@es ,
                           "involves person"@en .


###  https://w3id.org/WiFi-CSI#machineStatus
:machineStatus rdf:type owl:ObjectProperty ;
               rdfs:domain :WifiMeasurement ;
               rdfs:range :MachineStatus ;
               rdfs:comment "Relaciona una medición WiFi con el estado operativo de una máquina durante la medición"@es ,
                            "Relates a WiFi measurement to the operational status of a machine during the measurement"@en ;
               rdfs:label "Estado de la máquina"@es ,
                          "Machine status"@en .


###  https://w3id.org/WiFi-CSI#measurementDuration
:measurementDuration rdf:type owl:ObjectProperty ;
                     rdfs:domain :WifiMeasurement ;
                     rdfs:range :Duration ;
                     rdfs:comment "Relaciona una medición WiFi con su duración en segundos"@es ,
                                  "Relates a WiFi measurement to its duration in seconds"@en ;
                     rdfs:label "Duración de la medición"@es ,
                                "Measurement duration"@en .


###  https://w3id.org/WiFi-CSI#wifiStandard
:wifiStandard rdf:type owl:ObjectProperty ;
              rdfs:domain :WifiMeasurement ;
              rdfs:range :WifiStandard ;
              rdfs:comment "Relaciona una medición WiFi con el estándar WiFi utilizado para la medición"@es ,
                           "Relates a WiFi measurement to the WiFi standard used for the measurement"@en ;
              rdfs:label "Estándar WiFi"@es ,
                         "WiFi standard"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/WiFi-CSI#campaign
:campaign rdf:type owl:DatatypeProperty ;
          rdfs:domain :WifiMeasurement ;
          rdfs:range xsd:string ;
          rdfs:comment "Identificador de la campaña de medición (e.g. MC1)."@es ,
                       "Measurement campaign identifier (e.g. MC1)."@en ;
          rdfs:label "campaign"@en ,
                     "campaña"@es .


###  https://w3id.org/WiFi-CSI#channel
:channel rdf:type owl:DatatypeProperty ;
         rdfs:domain :WifiMeasurement ;
         rdfs:range xsd:integer ;
         rdfs:comment "Canal WiFi utilizado durante la medición (11, 13 or 40)."@es ,
                      "WiFi channel used during the measurement (11, 13 or 40)."@en ;
         rdfs:label "canal"@es ,
                    "channel"@en .


###  https://w3id.org/WiFi-CSI#machine
:machine rdf:type owl:DatatypeProperty ;
         rdfs:domain :WifiMeasurement ;
         rdfs:range xsd:integer ;
         rdfs:comment "Identificador de la máquina presente durante la medición (1–9)."@es ,
                      "Identifier of the machine present during the measurement (1–9)."@en ;
         rdfs:label "machine"@en ,
                    "máquina"@es .


###  https://w3id.org/WiFi-CSI#nFiles
:nFiles rdf:type owl:DatatypeProperty ;
        rdfs:domain :WifiMeasurement ;
        rdfs:range xsd:integer ;
        rdfs:comment "Número total de archivos .mat en el conjunto al que pertenece esta medición."@es ,
                     "Total number of .mat files in the set this measurement belongs to."@en ;
        rdfs:label "number of files"@en ,
                   "número de archivos"@es .


###  https://w3id.org/WiFi-CSI#nMachine
:nMachine rdf:type owl:DatatypeProperty ;
          rdfs:domain :WifiMeasurement ;
          rdfs:range xsd:integer ;
          rdfs:comment "Número total de máquinas involucradas en la medición."@es ,
                       "Total number of machines involved in the measurement."@en ;
          rdfs:label "number of machines"@en ,
                     "número de máquinas"@es .


###  https://w3id.org/WiFi-CSI#nPeople
:nPeople rdf:type owl:DatatypeProperty ;
         rdfs:domain :WifiMeasurement ;
         rdfs:range xsd:integer ;
         rdfs:comment "Número total de personas presentes durante la medición."@es ,
                      "Total number of people present during the measurement."@en ;
         rdfs:label "number of people"@en ,
                    "número de personas"@es .


###  https://w3id.org/WiFi-CSI#nReceivers
:nReceivers rdf:type owl:DatatypeProperty ;
            rdfs:domain :WifiMeasurement ;
            rdfs:range xsd:integer ;
            rdfs:comment "Number of receiver devices used in the measurement (1–4)."@en ,
                         "Número de dispositivos receptores utilizados en la medición (1–4)."@es ;
            rdfs:label "number of receivers"@en ,
                       "número de receptores"@es .


###  https://w3id.org/WiFi-CSI#nic
:nic rdf:type owl:DatatypeProperty ;
     rdfs:domain :WifiMeasurement ;
     rdfs:range xsd:string ;
     rdfs:comment "Model of the network interface card of the CSI receiver."@en ,
                  "Modelo de la tarjeta de interfaz de red del receptor de CSI."@es ;
     rdfs:label "NIC"@en ,
                "NIC"@es .


###  https://w3id.org/WiFi-CSI#occupiedSubcarriers
:occupiedSubcarriers rdf:type owl:DatatypeProperty ;
                     rdfs:domain :WifiMeasurement ;
                     rdfs:range xsd:integer ;
                     rdfs:comment "Number of useful subcarriers (data + pilots) after excluding null subcarriers per IEEE 802.11n/ac."@en ,
                                  "Número de subportadoras útiles (datos + pilotos) después de excluir las subportadoras nulas según IEEE 802.11n/ac."@es ;
                     rdfs:label "occupied subcarriers"@en ,
                                "subportadoras ocupadas"@es .


###  https://w3id.org/WiFi-CSI#receiver
:receiver rdf:type owl:DatatypeProperty ;
          rdfs:domain :WifiMeasurement ;
          rdfs:range xsd:integer ;
          rdfs:comment "Identificador del dispositivo receptor que capturó la medición (1–4)."@es ,
                       "Identifier of the receiver device that captured the measurement (1–4)."@en ;
          rdfs:label "receiver"@en ,
                     "receptor"@es .


###  https://w3id.org/WiFi-CSI#sequentialNumber
:sequentialNumber rdf:type owl:DatatypeProperty ;
                  rdfs:domain :WifiMeasurement ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "Número secuencial para distinguir mediciones con metadatos idénticos."@es ,
                               "Sequential number to distinguish measurements with otherwise identical metadata."@en ;
                  rdfs:label "número secuencial"@es ,
                             "sequential number"@en .


###  https://w3id.org/WiFi-CSI#set
:set rdf:type owl:DatatypeProperty ;
     rdfs:domain :WifiMeasurement ;
     rdfs:range xsd:string ;
     rdfs:comment "Identificador del conjunto dentro de la campaña (e.g. MC1_01A). Cada conjunto corresponde a una ubicación específica."@es ,
                  "Set identifier within the campaign (e.g. MC1_01A). Each set corresponds to a specific location."@en ;
     rdfs:label "conjunto"@es ,
                "set"@en .


###  https://w3id.org/WiFi-CSI#subcarriers
:subcarriers rdf:type owl:DatatypeProperty ;
             rdfs:domain :WifiMeasurement ;
             rdfs:range xsd:integer ;
             rdfs:comment "Número total de subportadoras OFDM capturadas (64 para 20 MHz, 256 para 80 MHz en MC1)."@es ,
                          "Total number of OFDM subcarriers captured (64 for 20 MHz, 256 for 80 MHz in MC1)."@en ;
             rdfs:label "subcarriers"@en ,
                        "subportadoras"@es .


###  https://w3id.org/WiFi-CSI#traffic
:traffic rdf:type owl:DatatypeProperty ;
         rdfs:domain :WifiMeasurement ;
         rdfs:range xsd:string ;
         rdfs:comment "Network traffic type present during the measurement (e.g. FTP)."@en ,
                      "Tipo de tráfico de red presente durante la medición (e.g. FTP)."@es ;
         rdfs:label "traffic"@en ,
                    "tráfico"@es .


#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/Quantity
<http://qudt.org/schema/qudt/Quantity> rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/Observation
<http://www.w3.org/ns/sosa/Observation> rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/Result
<http://www.w3.org/ns/sosa/Result> rdf:type owl:Class .


###  https://w3id.org/WiFi-CSI#Activity
:Activity rdf:type owl:Class ;
          rdfs:comment "Tipo de actividad realizada por una persona durante la medición WiFi"@es ,
                       "Type of activity performed by a person during the WiFi measurement"@en ;
          rdfs:label "Actividad"@es ,
                     "Activity"@en .


###  https://w3id.org/WiFi-CSI#Application
:Application rdf:type owl:Class ;
             rdfs:comment "Tipo de aplicación o caso de uso de una medición WiFi"@es ,
                          "Type of application or use case of a WiFi measurement"@en ;
             rdfs:label "Aplicación"@es ,
                        "Application"@en .


###  https://w3id.org/WiFi-CSI#Bandwidth
:Bandwidth rdf:type owl:Class ;
           rdfs:subClassOf <http://qudt.org/schema/qudt/Quantity> ;
           rdfs:comment "Ancho de banda de la señal WiFi, expresado en MHz (20 MHz o 80 MHz)"@es ,
                        "Bandwidth of the WiFi signal, expressed in MHz (20 MHz or 80 MHz)"@en ;
           rdfs:label "Ancho de banda"@es ,
                      "Bandwidth"@en .


###  https://w3id.org/WiFi-CSI#CSIExtractor
:CSIExtractor rdf:type owl:Class ;
              rdfs:comment "Herramienta o método utilizado para extraer los datos CSI de las señales WiFi crudas"@es ,
                           "Software tool or method used to extract CSI data from the raw WiFi signals"@en ;
              rdfs:label "CSI Extractor"@en ,
                         "Extractor de CSI"@es .


###  https://w3id.org/WiFi-CSI#CSIResult
:CSIResult rdf:type owl:Class ;
           rdfs:subClassOf <http://www.w3.org/ns/sosa/Result> ;
           rdfs:comment "Recurso que referencia al archivo .mat con datos CSI/RSSI/timestamps"@es ,
                        "Result of a WiFi measurement containing the CSI/RSSI data and timestamps"@en ;
           rdfs:label "CSI Result"@en ,
                      "Resultado CSI"@es .


###  https://w3id.org/WiFi-CSI#Duration
:Duration rdf:type owl:Class ;
          rdfs:subClassOf <http://qudt.org/schema/qudt/Quantity> ;
          rdfs:comment "Duración de la medición WiFi en segundos"@es ,
                       "Duration of the WiFi measurement in seconds"@en ;
          rdfs:label "Duración (segundos)"@es ,
                     "Duration (seconds)"@en .


###  https://w3id.org/WiFi-CSI#Environment
:Environment rdf:type owl:Class ;
             rdfs:comment "Tipo de entorno físico donde se tomó la medición WiFi"@es ,
                          "Type of physical environment where the WiFi measurement was taken"@en ;
             rdfs:label "Entorno"@es ,
                        "Environment"@en .


###  https://w3id.org/WiFi-CSI#FrequencyBand
:FrequencyBand rdf:type owl:Class ;
               rdfs:subClassOf <http://qudt.org/schema/qudt/Quantity> ;
               rdfs:comment "Banda de frecuencia de la señal WiFi, expresada en GHz (2.4 GHz o 5 GHz)"@es ,
                            "Frequency band of the WiFi signal, expressed in GHz (2.4 GHz or 5 GHz)"@en ;
               rdfs:label "Banda de frecuencia"@es ,
                          "Frequency band"@en .


###  https://w3id.org/WiFi-CSI#MachineStatus
:MachineStatus rdf:type owl:Class ;
               rdfs:comment "Estado operativo de una máquina durante la medición WiFi"@es ,
                            "Operational status of a machine during the WiFi measurement"@en ;
               rdfs:label "Estado de la máquina"@es ,
                          "Machine Status"@en .


###  https://w3id.org/WiFi-CSI#Person
:Person rdf:type owl:Class ;
        rdfs:comment "Identificador de una persona participante en una medición WiFi por medio de una letra minúscula (a-u)"@es ,
                     "Identifier for a person involved during a WiFi measurement by a lowercase letter (a-u)"@en ;
        rdfs:label "Person"@en ,
                   "Persona"@es .


###  https://w3id.org/WiFi-CSI#WifiMeasurement
:WifiMeasurement rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ;
                 rdfs:comment "Observación o medición basada en señales WiFi (CSI) en un entorno específico"@es ,
                              "WiFi measurement based on CSI data in a specific environment"@en ;
                 rdfs:label "Medición WiFi"@es ,
                            "Wifi measurement"@en .


###  https://w3id.org/WiFi-CSI#WifiStandard
:WifiStandard rdf:type owl:Class ;
              rdfs:comment "Estándar WiFi utilizado para la medición"@es ,
                           "WiFi standard used for the measurement"@en ;
              rdfs:label "Estándar WiFi"@es ,
                         "WiFi Standard"@en .


#################################################################
#    Individuals
#################################################################

###  https://doi.org/10.5281/zenodo.21316011
<https://doi.org/10.5281/zenodo.21316011> rdf:type owl:NamedIndividual ;
                                          owl:sameAs <https://w3id.org/WiFi-CSI> .


###  https://w3id.org/WiFi-CSI
<https://w3id.org/WiFi-CSI> rdf:type owl:NamedIndividual .


###  https://w3id.org/WiFi-CSI
<https://w3id.org/WiFi-CSI> rdf:type owl:NamedIndividual .


###  https://w3id.org/WiFi-CSI#AtherosCSIExtractor
:AtherosCSIExtractor rdf:type owl:NamedIndividual ,
                              :CSIExtractor ;
                     rdfs:comment "CSI extractor based on the Nexmon framework for Atheros WiFi chipsets"@en ,
                                  "Extractor de CSI basado en el framework Nexmon para chipsets WiFi Atheros"@es ;
                     rdfs:label "Atheros CSI Extractor"@en ,
                                "Extractor de CSI Atheros"@es ;
                     <http://www.w3.org/2004/02/skos/core#notation> "ACT" .


###  https://w3id.org/WiFi-CSI#BasementRoom
:BasementRoom rdf:type owl:NamedIndividual ,
                       :Environment ;
              rdfs:comment "Medición WiFi tomada en un entorno de sótano"@es ,
                           "WiFi measurement taken in a basement environment"@en ;
              rdfs:label "Basement Room"@en ,
                         "Sótano"@es .


###  https://w3id.org/WiFi-CSI#Classroom
:Classroom rdf:type owl:NamedIndividual ,
                    :Environment ;
           rdfs:comment "Medición WiFi tomada en un entorno de aula con pupitres y sillas"@es ,
                        "WiFi measurement taken in a classroom environment with desks and chairs"@en ;
           rdfs:label "Aula"@es ,
                      "Classroom"@en .


###  https://w3id.org/WiFi-CSI#Empty
:Empty rdf:type owl:NamedIndividual ,
                :Activity ;
       rdfs:comment "No hay actividad de ninguna persona durante la medición WiFi"@es ,
                    "No person activity is present during the WiFi measurement"@en ;
