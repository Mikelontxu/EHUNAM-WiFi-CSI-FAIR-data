@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Change the following domain and prefix declarations to match your dataset's namespace and prefix.
@prefix dataset: <http://34.51.146.173:8090/wifi-csi/dataset/> .
@prefix : <http://34.51.146.173:8090/wifi-csi/shapes#> .

# Dataset-level checks

:DatasetShape a sh:NodeShape ;
  sh:targetNode dataset:EHUNAM-WiFi-CSI-FAIR-data ;
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
  ] ;
  sh:property [
    sh:path dct:description ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
  ] ;
  sh:property [
    sh:path dct:license ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path dct:source ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path dcat:keyword ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
  ] .