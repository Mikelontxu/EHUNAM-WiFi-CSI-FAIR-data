@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
#@prefix wifi: <https://ehu/wifi-csi/ontology#> .
@prefix wifi: <http://34.51.146.173:8090/ontology/wifi_activity.ttl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix time: <http://www.w3.org/2006/time#> .
#@prefix : <https://ehu/wifi-csi/shapes#> .
@prefix : <http://34.51.146.173:8090/wifi-csi/shapes#> .
#@prefix dataset: <https://ehu/wifi-csi/dataset/> .
@prefix dataset: <http://34.51.146.173:8090/wifi-csi/dataset/> .


# Measurement checks

:MeasurementShape a sh:NodeShape ;
  sh:targetClass wifi:WifiMeasurement ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [ 
    sh:path wifi:campaign ; 
    sh:minCount 1 ;
  ] ;
  sh:property [ 
    sh:path wifi:set ; 
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path wifi:receiver ;
    sh:minCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
    sh:maxInclusive 4 ;
    sh:message "receiver must be an integer between 1 and 4" ;
  ] ;
  sh:property [ 
    sh:path wifi:application ; 
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [ 
    sh:path wifi:activity ; 
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [ 
    sh:path wifi:environment ; 
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [ 
    sh:path wifi:wifiStandard ; 
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [ 
    sh:path wifi:csiExtractor ; 
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path wifi:frequencyBand ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path wifi:bandwidth ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [ 
    sh:path wifi:measurementDuration ; 
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [ 
    sh:path wifi:sequentialNumber ; 
    sh:minCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [ 
    sh:path wifi:nPeople ; 
    sh:minCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [ 
    sh:path wifi:nReceivers ; 
    sh:minCount 1 ; 
    sh:datatype xsd:integer ;
  ] ;
  sh:property [ 
    sh:path wifi:nFiles ; 
    sh:minCount 1 ; 
    sh:datatype xsd:integer ;
  ] ;
  sh:property [ 
    sh:path wifi:subcarriers ; 
    sh:minCount 1 ; 
    sh:datatype xsd:integer ;
  ] ;
  sh:property [ 
    sh:path wifi:occupiedSubcarriers ; 
    sh:minCount 1 ; 
    sh:datatype xsd:integer ;
  ] ;
  sh:property [ 
    sh:path wifi:involvesPerson ; 
    sh:minCount 0 ; 
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [ 
    sh:path wifi:nic ; 
    sh:minCount 1 ; 
    sh:datatype xsd:string ;
  ] ;
  sh:property [ 
    sh:path wifi:traffic ; 
    sh:minCount 1 ; 
    sh:datatype xsd:string ;
  ] ;
  sh:property [ 
    sh:path sosa:resultTime ; 
    sh:minCount 1 ;
    sh:nodeKind sh:IRI;
  ] ;
  sh:property [ 
    sh:path sosa:hasResult ; 
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [ 
    sh:path prov:wasGeneratedBy ; 
    sh:minCount 1 ; 
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path wifi:channel ;
    sh:minCount 1 ;
    sh:datatype xsd:integer ;
    sh:in (11 13 40) ;
    sh:message "channel must be 11, 13, or 40" ;
  ] ;
  sh:property [
    sh:path (wifi:bandwidth qudt:numericValue) ;
    sh:minCount 1 ;
    sh:datatype xsd:double ;
    sh:in ("20.0"^^xsd:double "80.0"^^xsd:double) ;
    sh:message "bandwidth must be 20 or 80 MHz" ;
  ] .

# Person checks

:InvolvedPersonShape a sh:NodeShape ;
  sh:targetObjectsOf wifi:involvesPerson ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue wifi:Person ;
    sh:message "every wifi:involvesPerson target must have rdf:type wifi:Person" ;
  ] .

# QUDT cchecks (Bandwidth, FrequencyBand, Duration)

:QuantityValueShape a sh:NodeShape ;
  sh:targetClass wifi:Bandwidth, wifi:FrequencyBand, wifi:Duration ;
  sh:property [
    sh:path qudt:numericValue ;
    sh:minCount 1 ;
    sh:datatype xsd:double ;
  ] ;
  sh:property [
    sh:path qudt:unit ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] .


# Time checks

:TimeInstantShape a sh:NodeShape ;
  sh:targetClass time:Instant ;
  sh:property [
    sh:path time:inXSDDateTimeStamp ;
    sh:minCount 1 ;
    sh:datatype xsd:dateTimeStamp ;
  ] .

# Result checks

:ResultShape a sh:NodeShape ;
  sh:targetClass wifi:CSIResult ;
  sh:property [
    sh:path dcat:downloadURL ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path dct:format ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path spdx:checksum ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path dcat:downloadURL ;
    sh:not [ sh:pattern ".*#.*" ] ;
    sh:message "downloadURL must not contain '#'" ;
  ] .

:ChecksumShape a sh:NodeShape ;
  sh:targetClass spdx:Checksum ;
  sh:property [
    sh:path spdx:algorithm ;
    sh:minCount 1 ;
    sh:hasValue spdx:checksumAlgorithm_sha256 ;
  ] ;
  sh:property [
    sh:path spdx:checksumValue ;
    sh:minCount 1 ;
    sh:pattern "^[0-9a-f]{64}$" ;
    sh:message "checksumValue must be a 64-character lowercase hexadecimal string" ;
  ] .